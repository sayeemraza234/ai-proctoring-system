# ==============================================================================
# ProctorAI Environment Configuration Template (.env.example)
# Duplicate this file as .env or backend/.env and populate with your credentials.
# NEVER commit your active .env file containing private keys to Git.
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/proctorai
ALLOW_IN_MEMORY_DB=true

# Google Gemini API Key
# Securely loaded on server-side only to power:
# 1. Candidate automated code evaluation (/api/ai/evaluate)
# 2. Adaptive follow-up question probing (/api/ai/suggest-followup)
# 3. AI question generator (/api/ai/generate-questions)
# 4. Multimodal proctoring webcam frame analysis (/api/proctor/analyze-frame)
# 5. Server-side proxy gateway (/api/ai/proxy)
# Obtain a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Sandboxed Code Execution (Optional)
JUDGE0_API_KEY=your_judge0_api_key_here
